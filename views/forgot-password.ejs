<!DOCTYPE html>
<html>
<head><%- include('partials/head', { title: 'Forgot password - VASUP-Testdata' }) %></head>
<body>
<div class="auth-shell">
  <div class="auth-card">
    <h1>Forgot password</h1>
    <% if (sent) { %>
      <div class="notice-box">If that email has an approved VASUP-Testdata account, a reset link has been sent.</div>
    <% } else { %>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="post" action="/forgot-password">
        <div class="field">
          <label>VASUP email</label>
          <input type="email" name="email" placeholder="name@vasup.co.th" required />
        </div>
        <button class="btn" type="submit" style="width:100%;">Send reset link</button>
      </form>
    <% } %>
    <div class="auth-links"><a href="/login">Back to login</a></div>
  </div>
</div>
</body>
</html>

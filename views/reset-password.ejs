<!DOCTYPE html>
<html>
<head><%- include('partials/head', { title: 'Set password - VASUP-Testdata' }) %></head>
<body>
<div class="auth-shell">
  <div class="auth-card">
    <h1><%= force ? 'Set a new password' : 'Reset your password' %></h1>
    <% if (force) { %><p class="sub">This is your first login with a temporary password - please choose your own.</p><% } %>
    <% if (error) { %><div class="error-box"><%= error %></div><% } %>
    <form method="post" action="/reset-password/<%= force ? 'force' : token %>">
      <div class="field">
        <label>New password (min 8 characters)</label>
        <input type="password" name="password" minlength="8" required />
      </div>
      <div class="field">
        <label>Confirm new password</label>
        <input type="password" name="confirm" minlength="8" required />
      </div>
      <button class="btn" type="submit" style="width:100%;">Save password</button>
    </form>
  </div>
</div>
</body>
</html>

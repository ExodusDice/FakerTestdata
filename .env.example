# Copy this file to .env and fill in real values before running in production.

# --- App ---
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
APP_BASE_URL=http://localhost:3000

# --- Approval / notification routing ---
# The super-admin / approver. wisanu.a@vasup.co.th is also seeded as the sadmin/sadmin login below.
SADMIN_EMAIL=wisanu.a@vasup.co.th
ADMIN_EMAIL=admin@vasup.co.th

# --- Hardcoded configuration accounts ---
# These two logins always work regardless of the users store, for internal configuration
# (e.g. banning testers). Change the passwords here for any real deployment.
SADMIN_USERNAME=sadmin
SADMIN_PASSWORD=sadmin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Email (SMTP) ---
# If left blank, outgoing mail is written to data/outbox/ and logged in the admin portal
# instead of actually being sent, so the app still runs end-to-end without real SMTP creds.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VASUP-Testdata <no-reply@vasup.co.th>"

# --- AI (Anthropic Claude) ---
# If left blank, the app falls back to a built-in offline mock generator so test data
# requests still work without an API key (clearly labeled as offline/mock in the output).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
